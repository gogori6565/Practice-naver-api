<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>도서 검색 서비스</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .search-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            padding: 3rem;
            margin-top: 5rem;
        }
        .search-icon {
            font-size: 4rem;
            color: #667eea;
            margin-bottom: 1rem;
        }
        .search-input {
            border-radius: 50px;
            border: 2px solid #e9ecef;
            padding: 1rem 1.5rem;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }
        .search-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .search-btn {
            border-radius: 50px;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            transition: all 0.3s ease;
        }
        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        .title {
            color: #2c3e50;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        .subtitle {
            color: #6c757d;
            font-weight: 400;
            margin-bottom: 2rem;
        }
        .feature-card {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 15px;
            padding: 1.5rem;
            margin: 1rem 0;
            border: none;
            transition: transform 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
        }
        .developer-footer {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
            border-radius: 10px;
            padding: 1rem;
            margin-top: 2rem;
        }
        .developer-text {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="search-container text-center">
                <!-- 검색 아이콘 -->
                <i class="bi bi-book search-icon"></i>

                <!-- 제목 -->
                <h1 class="title">📚 도서 검색 서비스</h1>
                <p class="subtitle">찾고 싶은 도서의 제목이나 저자를 입력해주세요</p>

                <!-- 검색 폼 -->
                <form action="/book/result" method="get" class="mb-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <input type="text"
                                   class="form-control search-input"
                                   placeholder="예: 어린왕자, 문목하, 자바 프로그래밍..."
                                   name="bookname"
                                   required>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary search-btn w-100">
                                <i class="bi bi-search me-2"></i>검색하기
                            </button>
                        </div>
                    </div>
                </form>

                <!-- 기능 설명 카드들 -->
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card feature-card">
                            <div class="card-body">
                                <i class="bi bi-lightning-charge text-warning fs-3"></i>
                                <h6 class="mt-2">빠른 검색</h6>
                                <small class="text-muted">실시간으로 도서 정보를 검색합니다</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card feature-card">
                            <div class="card-body">
                                <i class="bi bi-book-half text-info fs-3"></i>
                                <h6 class="mt-2">풍부한 정보</h6>
                                <small class="text-muted">저자, 출판사, 책 표지 등 상세 정보 제공</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card feature-card">
                            <div class="card-body">
                                <i class="bi bi-heart text-danger fs-3"></i>
                                <h6 class="mt-2">사용자 친화적</h6>
                                <small class="text-muted">직관적이고 편리한 인터페이스</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 개발자 정보 Footer -->
            <div class="text-center">
                <div class="developer-footer">
                    <small class="developer-text">
                        <i class="bi bi-code-slash me-1"></i>
                        Developed by <strong>이주현</strong>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
